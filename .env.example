# ---------- Required (local .env.local AND Vercel Environment Variables) ----------
# MySQL connection URL (server-side only, never prefix with NEXT_PUBLIC_)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME  (URL-encode special characters in the password)
DATABASE_URL=mysql://root:your_mysql_password@localhost:3306/barcode_inventory
# Long random string (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=your_long_random_secret

# ---------- Optional: hosted MySQL ----------
# TLS: true (verify certificate) | required / no-verify (encrypt, don't verify) | leave unset for local MySQL
# DATABASE_SSL=true
# CA certificate PEM if your provider requires it (e.g. Aiven). One line with literal \n is fine.
# DATABASE_SSL_CA=
# Connections per server instance (default 3 in production, 10 in dev)
# DATABASE_POOL_SIZE=3

# ---------- Local only: used by `npm run create-admin`. Do NOT set these on Vercel. ----------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
